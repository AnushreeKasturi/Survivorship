---
// Self-hosted fonts: no request to Google, so visitors' IPs aren't shared with a third party.
import "@fontsource/instrument-serif/400.css";
import "@fontsource/geist/400.css";
import "@fontsource/geist/500.css";
import "@fontsource/geist-mono/400.css";
import "../styles/global.css";

const { title, description, page } = Astro.props;
const links = [
  ["/", "Overview", "home"],
  ["/startups/", "Startups", "startups"],
  ["/how-it-works/", "How it works", "how"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f6f9" />
    <script is:inline>
      // Apply the saved theme before first paint so the page doesn't flash.
      try { if (localStorage.getItem("theme") === "dark") document.documentElement.dataset.theme = "dark"; } catch (e) {}
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="wordmark" href="/">Survivorship <i>.:*</i></a>
      <nav aria-label="Pages">
        {links.map(([href, label, key]) => (
          <a href={href} aria-current={key === page ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <a class="live" href="/startups/#watchlist" data-live hidden><span class="pulse" aria-hidden="true"></span><span data-live-text>Watchlist</span></a>
      <a class="theme" href="https://github.com/AnushreeKasturi/Survivorship" aria-label="Source code on GitHub">
        <svg viewBox="0 0 16 16" aria-hidden="true" class="mark"><path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z" /></svg>
      </a>
      <button class="theme" type="button" aria-label="Dark theme" aria-pressed="false" data-theme-toggle>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path class="moon" d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /><g class="sun"><circle cx="12" cy="12" r="4.2" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></g></svg>
      </button>
    </header>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="dawn" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" style="stop-color: var(--g1)" /><stop offset="0.5" style="stop-color: var(--g2)" /><stop offset="1" style="stop-color: var(--g3)" />
        </linearGradient>
      </defs>
    </svg>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p class="ascii-rule" aria-hidden="true">·  .  :  ·  *  ·  :  .  ·</p>
      <p>A Big Data end-semester project in Scala and Apache Spark. Results are read from <code>results/</code>; live scores come from the Scala server.</p>
      <p>Data: Crunchbase snapshot via Kaggle (CDLA-Sharing 1.0). <a href="https://github.com/AnushreeKasturi/Survivorship">Source on GitHub</a>.</p>
    </footer>
    <script>import "../scripts/live.js";</script>
  </body>
</html>
