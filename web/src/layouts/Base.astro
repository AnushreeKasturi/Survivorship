---
import "../styles/global.css";

const { title, description, page } = Astro.props;
const links = [
  ["/", "Overview", "home"],
  ["/startups/", "Startups", "startups"],
  ["/how-it-works/", "How it works", "how"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1317" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Geist:wght@400;500&family=Geist+Mono&display=swap" rel="stylesheet" />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <a class="wordmark" href="/">Survival <i>.:*</i></a>
      <nav aria-label="Pages">
        {links.map(([href, label, key]) => (
          <a href={href} aria-current={key === page ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <a class="live" href="/startups/#watchlist" data-live hidden><span class="pulse" aria-hidden="true"></span><span data-live-text>Watchlist</span></a>
    </header>
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <linearGradient id="dawn" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#c98f45" /><stop offset="0.55" stop-color="#e3c182" /><stop offset="1" stop-color="#9cc2b2" />
        </linearGradient>
      </defs>
    </svg>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <p class="ascii-rule" aria-hidden="true">·  .  :  ·  *  ·  :  .  ·</p>
      <p>A Big Data end-semester project in Scala and Apache Spark. Results are read from <code>results/</code>; live scores come from the Scala server.</p>
      <p>Data: Crunchbase snapshot via Kaggle (CDLA-Sharing 1.0). <a href="https://github.com/AnushreeKasturi/bda_endsem">Source on GitHub</a>.</p>
    </footer>
    <script>import "../scripts/live.js";</script>
  </body>
</html>
