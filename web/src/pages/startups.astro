---
import Base from "../layouts/Base.astro";
import { caseStudies, structural } from "../lib/data.js";

const cases = caseStudies.cases;
const hits = cases.filter((c) => c.correct).length;
const closed = cases.filter((c) => c.profile.outcome === "closed").length;
---

<Base title="Real startups · Survivorship" description="Real startups scored by the pipeline: eight with known endings and a live watchlist." page="startups">
  <section style="padding-bottom: 40px">
    <div class="head center" style="margin: 0 auto">
      <h1 class="h1">Real startups</h1>
      <p class="lede">How the pipeline does on companies whose story we already know, and on some whose story is still being written.</p>
      <nav class="tabs" aria-label="On this page">
        <a href="#endings">Known endings</a>
        <a href="#watchlist">Watchlist</a>
        <a href="/archive/">Full archive</a>
      </nav>
    </div>
  </section>

  <section id="endings" style="padding-top: 60px">
    <div class="head center">
      <h2 class="h2">Known endings</h2>
      <p class="lede">
        {closed} that closed and {cases.length - closed} that made it, each scored as of a date when its fate was still open.
        The {caseStudies.model ?? "model"} calls <span class="glow">{hits} of {cases.length}</span> correctly; the logistic regression
        it replaced called {structural.base.caseStudies.correctAt05}. Eight endings are too few to judge a model by, so the
        benchmark below them is what decides.
      </p>
    </div>
    <ul class="tiles" id="cases"></ul>
    <script type="application/json" id="case-data" set:html={JSON.stringify(cases)}></script>
    <details class="more" style="max-width: 1100px">
      <summary>How these were chosen and scored</summary>
      <p class="muted">
        Founding dates, first funding rounds and outcomes were checked against the public sources linked in each card; dates known
        only to the year are set to 1 July. Each startup is scored two years after its first round, or six months before it shut
        down if that came sooner, using only news from the two years before that date, the same shape as the training data.
        The model is chosen by a cross-validated benchmark on all {structural.live ? "22,075" : ""} training startups, never by these eight:
        the random forest reaches AUC {structural.live.aucMean.toFixed(3)} against {structural.base.aucMean.toFixed(3)} for logistic regression.
      </p>
    </details>
  </section>

  <section id="watchlist">
    <div class="head center">
      <h2 class="h2">The watchlist</h2>
      <p class="lede">Well-known startups, re-checked every six hours against Google News and a growing GDELT news archive.</p>
    </div>
    <p class="status" id="watch-status" aria-live="polite">Loading the latest check…</p>
    <p class="offline center" hidden>The watchlist needs the Scala server. From <code>scala/</code>, run <code>sbt "runMain com.startupsurvival.web.Server"</code> and open <code>localhost:8080/startups/</code>.</p>
    <ul class="tiles" id="watch-curated"></ul>
    <div class="actions"><a class="btn ghost" href="/archive/">See every startup, or suggest one</a></div>
  </section>

  <script>import "../scripts/startups.js";</script>
</Base>
