---
import fs from "node:fs";
import path from "node:path";
import "../styles/global.css";

// Baked in at build time from the pipeline's own output - never hand-edited.
const results = path.resolve(process.cwd(), "../results");
const [header, ...lines] = fs.readFileSync(path.join(results, "experiment_results.csv"), "utf8").trim().split("\n");
const cols = header.split(",");
const rows = lines.map((line) => Object.fromEntries(line.split(",").map((v, i) => [cols[i], isNaN(+v) ? v : +v])));
const coefficients = JSON.parse(fs.readFileSync(path.join(results, "model_coefficients.json"), "utf8"));

const byName = Object.fromEntries(rows.map((r) => [r.experiment, r]));
const lift = (a, b) => byName[b].f1_label0 - byName[a].f1_label0;
const signed = (x, digits = 4) => (x >= 0 ? "+" : "−") + Math.abs(x).toFixed(digits);
const pct = (x) => (x * 100).toFixed(1);

const metrics = [
  ["accuracy", "Accuracy"],
  ["auc", "AUC-ROC"],
  ["f1_label0", "F1 · closed"],
  ["recall_label0", "Recall · closed"],
];

const topWeights = [...coefficients.financialSentiment.features]
  .sort((a, b) => Math.abs(b.coefficient) - Math.abs(a.coefficient))
  .slice(0, 6);

const stages = [
  ["HDFS", "Storage", "hadoop/hdfs_commands.md", "22,075 eligible startups land in HDFS after Phase 2's labelling and cutoff rules."],
  ["Hive", "Warehouse", "hive/schema.sql", "A structured table for SQL exploration, with a quote-aware SerDe after a real comma bug."],
  ["DataCleaner", "Scala", "DataCleaner.scala", "A quote-aware CSV fold turns each row into an immutable StartupRecord, or drops it."],
  ["NameMatcher", "Scala", "NameMatcher.scala", "Rejects headlines that never name the company, like Kabbage's “tomato barons” false hit."],
  ["SentimentScorer", "Scala", "SentimentScorer.scala", "Lexicon scoring with explainable term hits. Score = positive hits − negative hits."],
  ["Feature extraction", "Scala", "FeatureExtractor.scala", "Funding features behind a leakage guard, plus 12 sentiment aggregates per startup."],
  ["RDD join", "Spark", "spark/FeatureJoin.scala", "leftOuterJoin keeps every startup; no coverage means a zero sentiment baseline."],
  ["MLlib", "Spark", "ml/Evaluation.scala", "Weighted logistic regression and linear SVM on one shared 80/20 split."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Startup Survival</title>
    <meta name="description" content="Does public news sentiment improve startup survival prediction? A Scala + Spark pipeline, live." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <nav class="nav">
      <span class="mark">● survival</span>
      <a href="#pipeline">pipeline</a>
      <a href="#lab">lab</a>
      <a href="#results">results</a>
    </nav>

    <header class="hero">
      <p class="eyebrow">Big Data end-semester · Scala + Apache Spark</p>
      <h1 class="reveal-words">Can the news tell which startups <em>die</em>?</h1>
      <p class="lede">
        We trained four classifiers on 22,075 Crunchbase startups, with and without public news sentiment,
        to see whether headlines add anything to funding data.
      </p>
      <dl class="stats">
        <div><dt>startups</dt><dd data-count="22075">22,075</dd></div>
        <div><dt>cutoff</dt><dd>2013‑01‑01</dd></div>
        <div><dt>experiments</dt><dd data-count="4">4</dd></div>
        <div><dt>closed</dt><dd>13%</dd></div>
      </dl>
      <span class="scroll-cue" aria-hidden="true">scroll</span>
    </header>

    <section id="pipeline" class="pipeline">
      <div class="section-head">
        <p class="eyebrow">01 · pipeline</p>
        <h2>From a CSV to a verdict</h2>
      </div>
      <div class="track-wrap">
        <ol class="track">
          {stages.map(([name, tech, file, text], i) => (
            <li class="stage">
              <span class="stage-n">{String(i + 1).padStart(2, "0")}</span>
              <span class="stage-tech">{tech}</span>
              <h3>{name}</h3>
              <p>{text}</p>
              <code>{file}</code>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="lab" class="lab">
      <div class="section-head">
        <p class="eyebrow">02 · lab</p>
        <h2>Run the real code</h2>
        <p class="sub">Every panel below calls the Scala pipeline through <code>web/Server.scala</code>. Nothing is re-implemented in JavaScript.</p>
      </div>
      <p class="offline" hidden>The live lab needs the Scala server. From <code>scala/</code>, run <code>sbt "runMain com.startupsurvival.web.Server"</code> and open <code>localhost:8080</code>.</p>

      <div class="panels">
        <form class="panel" id="sentiment-form">
          <h3>Sentiment scorer</h3>
          <label for="s-headline">Headline</label>
          <input id="s-headline" name="headline" value="Startup X raises major funding and expands into new markets" maxlength="300" required />
          <button>Score</button>
          <div class="out" aria-live="polite">
            <p class="tokens" id="s-tokens"></p>
            <p class="big"><span id="s-score">–</span> <small id="s-class"></small></p>
          </div>
        </form>

        <form class="panel" id="match-form">
          <h3>Name matcher</h3>
          <label for="m-name">Company</label>
          <input id="m-name" name="name" value="Kabbage" maxlength="100" required />
          <label for="m-headline">Headline</label>
          <input id="m-headline" name="headline" value="The tomato barons of the occupied Western Sahara" maxlength="300" required />
          <button>Match</button>
          <div class="out" aria-live="polite">
            <div class="meter"><span id="m-bar"></span></div>
            <p class="big"><span id="m-confidence">–</span> <small id="m-reason"></small></p>
          </div>
        </form>

        <form class="panel wide" id="predict-form">
          <h3>Survival predictor</h3>
          <div class="grid">
            <div>
              <label for="p-founded">Founded</label>
              <input id="p-founded" name="foundedAt" type="date" value="2021-03-01" required />
              <label for="p-last">Last funding round</label>
              <input id="p-last" name="lastFundingAt" type="date" value="2024-06-01" />
              <label for="p-funding">Total funding (USD)</label>
              <input id="p-funding" name="fundingUsd" type="number" min="0" step="1000" value="4000000" />
              <label for="p-rounds">Funding rounds</label>
              <input id="p-rounds" name="rounds" type="number" min="0" step="1" value="2" />
            </div>
            <div>
              <label for="p-news">News, one per line as <code>YYYY-MM-DD: headline</code></label>
              <textarea id="p-news" name="headlines" rows="7">2024-06-02: Acme raises Series A to expand into Europe
2025-02-11: Acme faces lawsuit over delayed shipments
2025-09-30: Acme launches partnership with major retailer</textarea>
            </div>
          </div>
          <button>Predict</button>
          <div class="out verdict" aria-live="polite">
            <div><span class="label">Financial only</span><span class="big" id="p-fin">–</span></div>
            <div><span class="label">Financial + sentiment</span><span class="big" id="p-sent">–</span></div>
          </div>
          <p class="note">Probability of still operating, from the trained logistic regression weights. The model catches most closures but over-flags (closed recall ≈ 85%, precision ≈ 19%), so read this as a signal, not a verdict.</p>
          <p class="error" id="p-error"></p>
        </form>
      </div>
    </section>

    <section id="results" class="results">
      <div class="section-head">
        <p class="eyebrow">03 · results</p>
        <h2>Four experiments, one held‑out split</h2>
        <p class="sub">{rows[0].test_count.toLocaleString("en-US")} test startups. Logistic regression and linear SVM, each with and without sentiment features.</p>
      </div>

      <div class="experiments">
        {rows.map((r) => (
          <article class="exp">
            <header>
              <span class="exp-n">{r.experiment.replace("Experiment ", "0")}</span>
              <h3>{r.model}</h3>
              <p>{r.feature_set}</p>
            </header>
            {metrics.map(([key, label]) => (
              <div class="bar-row">
                <span>{label}</span>
                <div class="bar"><span style={`--w:${r[key]}`}></span></div>
                <b>{r[key].toFixed(3)}</b>
              </div>
            ))}
            <table class="cm" aria-label="Confusion matrix">
              <tr><th></th><th>pred closed</th><th>pred open</th></tr>
              <tr><th>closed</th><td class="hit">{r.tn}</td><td>{r.fp}</td></tr>
              <tr><th>open</th><td>{r.fn}</td><td class="hit">{r.tp}</td></tr>
            </table>
          </article>
        ))}
      </div>

      <div class="answer">
        <p class="eyebrow">the answer, for now</p>
        <div class="lifts">
          <div><span class="label">LR · Exp 3 − Exp 1 · F1 closed</span><span class="huge">{signed(lift("Experiment 1", "Experiment 3"))}</span></div>
          <div><span class="label">SVM · Exp 4 − Exp 2 · F1 closed</span><span class="huge">{signed(lift("Experiment 2", "Experiment 4"))}</span></div>
        </div>
        <p>
          Sentiment changes almost nothing yet, and that is expected. Only three startups have collected news so far,
          so the other {(22075 - 3).toLocaleString("en-US")} sit on a zero baseline. The comparison becomes meaningful once batch news collection runs.
          Best AUC so far is {pct(Math.max(...rows.map((r) => r.auc)))}%.
        </p>
        <h3>Largest learned weights (LR, financial + sentiment)</h3>
        <ul class="weights">
          {topWeights.map((w) => (
            <li><code>{w.name}</code><span class={w.coefficient < 0 ? "neg" : "pos"}>{signed(w.coefficient, 3)}</span></li>
          ))}
        </ul>
      </div>
    </section>

    <footer class="foot">
      <p>Run it yourself: <code>cd web && npm run build</code>, then <code>cd scala && sbt "runMain com.startupsurvival.web.Server"</code>.</p>
      <p>Data: Crunchbase snapshot via Kaggle (CDLA-Sharing 1.0). Every number on this page comes from <code>results/</code>.</p>
    </footer>

    <script>import "../scripts/app.js";</script>
  </body>
</html>
